# Tolaria Web — production environment (copy to /etc/tolaria-web.env, chmod 600)
# Never commit real values. Generate secrets with: openssl rand -base64 48

# JWT signing secret (REQUIRED — otherwise sessions reset every restart)
TOLARIA_JWT_SECRET=change-me-openssl-rand-base64-48

# Admin password (bcrypt-hashed into users.json on first boot; rotate after)
TOLARIA_ADMIN_PASSWORD=change-me-strong-password

# Vault path (a clone of totnormal/tolaria-vault)
TOLARIA_VAULT_PATH=/var/lib/tolaria/vault

# Prod mode (server serves built ../web/dist; no Vite dev)
NODE_ENV=production

# Cookie security (the app is behind https via Cloudflare)
TOLARIA_SECURE_COOKIE=true

# CORS allowlist (optional — same-origin via nginx needs none)
# TOLARIA_WEB_ORIGIN=https://tolaria.tarnovski.com
